# Database Configuration
DB_HOST={{ db_host | default('db') }}
DB_USER={{ db_user | default('finance_user') }}
DB_PASSWORD={{ db_password | default('changeme') }}
DB_NAME={{ db_name | default('finance_db') }}
DB_PORT=3306

# MySQL Root
MYSQL_ROOT_PASSWORD={{ db_password | default('changeme') }}
MYSQL_USER={{ db_user | default('finance_user') }}
MYSQL_PASSWORD={{ db_password | default('changeme') }}
MYSQL_DATABASE={{ db_name | default('finance_db') }}

# Application
debug_mode=False
log_level=INFO
app_secret={{ app_secret | default('changeme') }}

# Grafana
GRAFANA_ADMIN_PASSWORD={{ grafana_password | default('admin') }}
