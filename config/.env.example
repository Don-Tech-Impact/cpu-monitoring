# ============================================================
# Finance & Asset Tracking SaaS — Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# --- Database (MySQL inside Docker) ---
# Inside containers:  db:3306
# From your host machine: localhost:3307
DB_HOST=db
DB_PORT=3306
DB_USER=finance_user
DB_PASSWORD=changeme_strong_password
DB_NAME=finance_db

# --- MySQL Root credentials (used by Docker to init the DB) ---
MYSQL_ROOT_PASSWORD=changeme_root_password
MYSQL_USER=finance_user
MYSQL_PASSWORD=changeme_strong_password
MYSQL_DATABASE=finance_db

# --- Redis ---
# Inside containers  → redis:6379   (internal Docker network)
# From your host     → localhost:6380  (mapped to avoid conflict with any local Redis on 6379)
REDIS_URL=redis://redis:6379/0

# --- JWT Security ---
# Generate strong secrets with:
#   python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=changeme-replace-with-64-char-random-hex
JWT_REFRESH_SECRET_KEY=changeme-replace-with-different-64-char-random-hex
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# --- Application ---
FLASK_ENV=development
FLASK_DEBUG=false
LOG_LEVEL=INFO

# --- Security ---
# bcrypt work factor (min 12 per security requirements, higher = slower but safer)
BCRYPT_LOG_ROUNDS=12

# --- CORS (comma-separated list of allowed origins) ---
# Update these to match your frontend URL
CORS_ORIGINS=http://localhost:8090,http://localhost:5001

# --- Rate Limiting ---
RATE_LIMIT_LOGIN=10 per minute
RATE_LIMIT_REGISTER=5 per minute
RATE_LIMIT_GLOBAL=200 per hour

# --- Grafana (monitoring dashboard) ---
GRAFANA_ADMIN_PASSWORD=changeme_grafana_password

# --- File Uploads ---
UPLOAD_FOLDER=uploads
MAX_UPLOAD_SIZE_MB=5

# ============================================================
# HOST PORT MAPPING REFERENCE (to avoid conflicts)
# ============================================================
# Service       Host Port → Container Port   URL
# -------       ---------   --------------   ---
# App (nginx)   8090      → 80              http://localhost:8090
# MySQL DB      3307      → 3306            localhost:3307
# Redis         6380      → 6379            localhost:6380
# Adminer       8092      → 8080            http://localhost:8092
# Prometheus    9091      → 9090            http://localhost:9091
# Grafana       3001      → 3000            http://localhost:3001
# ============================================================
