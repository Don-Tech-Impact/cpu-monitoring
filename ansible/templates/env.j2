# ============================================================
# Finance & Asset Tracking SaaS — Environment (generated by Ansible)
# ============================================================

# --- Database ---
DB_HOST={{ db_host | default('db') }}
DB_PORT=3306
DB_USER={{ db_user | default('finance_user') }}
DB_PASSWORD={{ db_password }}
DB_NAME={{ db_name | default('finance_db') }}

# --- MySQL Root ---
MYSQL_ROOT_PASSWORD={{ mysql_root_password | default(db_password) }}
MYSQL_USER={{ db_user | default('finance_user') }}
MYSQL_PASSWORD={{ db_password }}
MYSQL_DATABASE={{ db_name | default('finance_db') }}

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- JWT Security ---
JWT_SECRET_KEY={{ jwt_secret_key }}
JWT_REFRESH_SECRET_KEY={{ jwt_refresh_secret_key }}
JWT_ACCESS_TOKEN_EXPIRY_MINUTES={{ jwt_access_expiry | default(15) }}
JWT_REFRESH_TOKEN_EXPIRY_DAYS={{ jwt_refresh_expiry | default(7) }}

# --- Application ---
FLASK_ENV={{ flask_env | default('production') }}
FLASK_DEBUG=false
LOG_LEVEL={{ log_level | default('INFO') }}

# --- Security ---
BCRYPT_LOG_ROUNDS={{ bcrypt_rounds | default(12) }}

# --- CORS ---
CORS_ORIGINS={{ cors_origins | default('https://yourdomain.com') }}

# --- Rate Limiting ---
RATE_LIMIT_LOGIN={{ rate_limit_login | default('10 per minute') }}
RATE_LIMIT_REGISTER={{ rate_limit_register | default('5 per minute') }}
RATE_LIMIT_GLOBAL={{ rate_limit_global | default('200 per hour') }}

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD={{ grafana_password }}

# --- File Uploads ---
UPLOAD_FOLDER=uploads
MAX_UPLOAD_SIZE_MB={{ max_upload_size | default(5) }}
